<Window x:Class="CertificateGenerator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CertificateGenerator.Wpf"
        Title="CertificateGenerator"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка проекта -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding ProjectName}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0078D4" />

            <TextBlock Text="{Binding ProjectPath}"
                       Foreground="#605E5C"
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Панель инструментов -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Загрузить таблицу в проект"
                        Command="{Binding LoadTableIntoProjectCommand}"
                        Background="#0078D4"
                        Foreground="White"
                        Padding="16,8"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand" />

                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="120"
                                 Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="Загрузка..."
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#605E5C"
                               FontSize="12" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding SelectedFilePath}"
                       Foreground="#605E5C"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{Binding TableSummary}"
                       Foreground="#107C10"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Плашка ошибки -->
        <Border Grid.Row="2"
                Background="#FDE7E9"
                BorderBrush="#C42B1C"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#C42B1C"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Таблица -->
        <DataGrid x:Name="ParticipantsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1" />
    </Grid>
</Window>