<Window x:Class="CertificateGenerator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CertificateGenerator.Wpf"
        xmlns:models="clr-namespace:CertificateGenerator.Core.Models;assembly=CertificateGenerator.Core"
        xmlns:converters="clr-namespace:CertificateGenerator.Wpf.Converters"
        Title="CertificateGenerator"
        Height="700"
        Width="1200"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:ByteArrayToBitmapImageConverter x:Key="ByteArrayToBitmapImage" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка проекта -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding ProjectName}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0078D4" />

            <TextBlock Text="{Binding ProjectPath}"
                       Foreground="#605E5C"
                       FontSize="12"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Панель инструментов -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Загрузить таблицу в проект"
                        Command="{Binding LoadTableIntoProjectCommand}"
                        Background="#0078D4"
                        Foreground="White"
                        Padding="16,8"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand" />

                <Button Content="Отменить изменения"
                        Command="{Binding ResetChangesCommand}"
                        Margin="8,0,0,0"
                        Padding="16,8"
                        FontSize="14"
                        Background="#F3F3F3"
                        BorderThickness="0"
                        Cursor="Hand" />

                <StackPanel Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="120"
                                 Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="Загрузка..."
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#605E5C"
                               FontSize="12" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding SelectedFilePath}"
                       Foreground="#605E5C"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{Binding TableSummary}"
                       Foreground="#107C10"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Плашка ошибки -->
        <Border Grid.Row="2"
                Background="#FDE7E9"
                BorderBrush="#C42B1C"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#C42B1C"
                       FontSize="13"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="3"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">

            <!-- Вкладка «Данные» -->
            <TabItem Header="Данные">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ParticipantsGrid"
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionUnit="Cell"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1" />

                    <!-- Панель полей проекта -->
                    <Border Grid.Column="1"
                            Width="300"
                            Margin="12,0,0,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Background="White">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Поля проекта"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#0078D4"
                                       Margin="0,0,0,8" />

                            <ListBox Grid.Row="1"
                                     x:Name="FieldsList"
                                     ItemsSource="{Binding Fields.Fields}"
                                     SelectedItem="{Binding Fields.SelectedField, Mode=TwoWay}"
                                     BorderBrush="#E0E0E0"
                                     BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock FontSize="11"
                                                       Foreground="#605E5C"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Обычное" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}"
                                                                         Value="{x:Static models:FieldKind.FullName}">
                                                                <Setter Property="Text" Value="ФИО" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}"
                                                                         Value="{x:Static models:FieldKind.Static}">
                                                                <Setter Property="Text" Value="Статическое" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Button Content="Добавить"
                                        Command="{Binding Fields.AddFieldCommand}"
                                        Padding="10,6"
                                        Background="#0078D4"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Content="Изменить"
                                        Command="{Binding Fields.EditFieldCommand}"
                                        Padding="10,6"
                                        Margin="6,0,0,0"
                                        Background="#F3F3F3"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Content="Удалить"
                                        Command="{Binding Fields.DeleteFieldCommand}"
                                        Padding="10,6"
                                        Margin="6,0,0,0"
                                        Background="#F3F3F3"
                                        BorderThickness="0"
                                        Cursor="Hand" />
                            </StackPanel>

                            <Border Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Padding="8"
                                    Background="#F8F8F8"
                                    CornerRadius="4"
                                    MaxHeight="200"
                                    Visibility="{Binding HasPreviews, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Предпросмотр (первый участник)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#605E5C"
                                                   Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding FieldPreviews}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding FieldName}"
                                                                   FontSize="11"
                                                                   Foreground="#605E5C" />
                                                        <TextBlock Text="{Binding PreviewValue}"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#202020" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка «Проверка» -->
            <TabItem Header="Проверка">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Сводка -->
                    <Border Grid.Row="0"
                            Padding="12,8"
                            CornerRadius="4"
                            Margin="0,0,0,12"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E6F4EA" />
                                <Setter Property="BorderBrush" Value="#107C10" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                        <Setter Property="Background" Value="#FDE7E9" />
                                        <Setter Property="BorderBrush" Value="#C42B1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ValidationSummary}"
                                   FontSize="14"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#107C10" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                            <Setter Property="Foreground" Value="#C42B1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Таблица проверки -->
                    <DataGrid x:Name="ValidationGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              RowHeight="28">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="BorderBrush" Value="#E0E0E0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                        <Setter Property="Background" Value="#FFF4CE" />
                                        <Setter Property="Foreground" Value="#8A6D00" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FDE7E9" />
                                        <Setter Property="Foreground" Value="#C42B1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка «Шаблон» -->
            <TabItem Header="Шаблон">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Кнопки + путь -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Загрузить PNG-шаблон"
                                    Command="{Binding Template.LoadTemplateCommand}"
                                    Background="#0078D4"
                                    Foreground="White"
                                    Padding="16,8"
                                    FontSize="14"
                                    BorderThickness="0"
                                    Cursor="Hand" />

                            <Button Content="Заменить шаблон"
                                    Command="{Binding Template.LoadTemplateCommand}"
                                    Margin="8,0,0,0"
                                    Padding="16,8"
                                    FontSize="14"
                                    Background="#F3F3F3"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Visibility="{Binding Template.HasTemplate, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Template.TemplatePath}"
                                   Foreground="#605E5C"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Template.HasTemplate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Панель зума -->
                    <Border Grid.Row="1"
                            Padding="8,6"
                            Margin="0,4,0,8"
                            Background="#F8F8F8"
                            CornerRadius="4"
                            Visibility="{Binding Template.HasTemplate, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Масштаб:"
                                       FontSize="12"
                                       Foreground="#605E5C"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <Button Content="−"
                                    Command="{Binding Template.ZoomOutCommand}"
                                    Width="28" Height="28"
                                    Padding="0" FontSize="16"
                                    Background="#F3F3F3"
                                    BorderThickness="0"
                                    Cursor="Hand" />

                            <Slider Value="{Binding Template.ZoomLevel, Mode=TwoWay}"
                                    Minimum="0.1"
                                    Maximum="4.0"
                                    Width="200"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="False" />

                            <Button Content="+"
                                    Command="{Binding Template.ZoomInCommand}"
                                    Width="28" Height="28"
                                    Padding="0" FontSize="16"
                                    Background="#F3F3F3"
                                    BorderThickness="0"
                                    Cursor="Hand" />

                            <Button Content="100%"
                                    Command="{Binding Template.ResetZoomCommand}"
                                    Margin="12,0,0,0"
                                    Padding="10,4"
                                    FontSize="12"
                                    Background="#F3F3F3"
                                    BorderThickness="0"
                                    Cursor="Hand" />

                            <TextBlock FontSize="12"
                                       Foreground="#605E5C"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                <TextBlock.Text>
                                    <Binding Path="Template.ZoomLevel"
                                             StringFormat="{}{0:P0}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Плашка ошибки вкладки «Шаблон» -->
                    <Border Grid.Row="2"
                            Background="#FDE7E9"
                            BorderBrush="#C42B1C"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,12"
                            Visibility="{Binding Template.HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Template.ErrorMessage}"
                                   Foreground="#C42B1C"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Основная область: список полей + шаблон -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: список полей -->
                        <Border Grid.Column="0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Background="White"
                                Margin="0,0,12,0">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Поля на шаблоне"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#0078D4"
                                           Margin="0,0,0,8" />

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Template.FieldRows}"
                                         SelectedItem="{Binding Template.SelectedFieldRow, Mode=TwoWay}"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Индикатор: галочка или точка -->
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="·" />
                                                            <Setter Property="Foreground" Value="#A0A0A0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPlacement}" Value="True">
                                                                    <Setter Property="Text" Value="✓" />
                                                                    <Setter Property="Foreground" Value="#107C10" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding KindLabel}"
                                                               FontSize="11"
                                                               Foreground="#605E5C"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Кнопка «Разместить поле» -->
                                <Button Grid.Row="2"
                                        Content="Разместить поле"
                                        Click="OnPlaceFieldClick"
                                        Margin="0,8,0,0"
                                        Padding="10,6"
                                        Background="#0078D4"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Template.HasTemplate}" Value="True" />
                                                        <Condition Binding="{Binding Template.SelectedFieldRow.HasPlacement}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Правая колонка: шаблон -->
                        <Border Grid.Column="1"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                Background="White">
                            <Grid>
                                <!-- Заглушка -->
                                <TextBlock Text="Шаблон не загружен"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#605E5C">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Template.HasTemplate}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Картинка + маркеры полей -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Visibility="{Binding Template.HasTemplate, Converter={StaticResource BoolToVisibility}}">
                                    <Canvas Width="{Binding Template.ScaledWidth}"
                                            Height="{Binding Template.ScaledHeight}">
                                        <!-- Картинка шаблона -->
                                        <Image Source="{Binding Template.PreviewImage, Converter={StaticResource ByteArrayToBitmapImage}}"
                                               Width="{Binding Template.ScaledWidth}"
                                               Height="{Binding Template.ScaledHeight}"
                                               Stretch="Fill" />

                                        <!-- Маркеры размещений -->
                                        <ItemsControl Width="{Binding Template.ScaledWidth}"
                                                      Height="{Binding Template.ScaledHeight}"
                                                      ItemsSource="{Binding Template.Placements}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding DisplayX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding DisplayY}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="OnPlacementMarkerClick"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalContentAlignment="Top">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Button.Template>

                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Маркер -->
                                                            <Ellipse VerticalAlignment="Top">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Width" Value="10" />
                                                                        <Setter Property="Height" Value="10" />
                                                                        <Setter Property="Fill" Value="#800078D4" />
                                                                        <Setter Property="Margin" Value="-5,-5,0,0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Width" Value="16" />
                                                                                <Setter Property="Height" Value="16" />
                                                                                <Setter Property="Margin" Value="-8,-8,0,0" />
                                                                                <Setter Property="Fill" Value="#0078D4" />
                                                                                <Setter Property="Stroke" Value="White" />
                                                                                <Setter Property="StrokeThickness" Value="2" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>

                                                            <!-- Подпись -->
                                                            <TextBlock Text="{Binding FieldName}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Top"
                                                                       Margin="4,-9,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#605E5C" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="#0078D4" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Панель настройки выбранного размещения -->
                    <Border Grid.Row="4"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="#FAFAFA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Visibility="{Binding Template.HasSelectedPlacement, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="X:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       Foreground="#605E5C" />
                            <TextBox Width="60"
                                     Padding="4,2"
                                     VerticalAlignment="Center"
                                     Text="{Binding Template.SelectedPlacement.X, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Y:"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0"
                                       Foreground="#605E5C" />
                            <TextBox Width="60"
                                     Padding="4,2"
                                     VerticalAlignment="Center"
                                     Text="{Binding Template.SelectedPlacement.Y, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Размер:"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0"
                                       Foreground="#605E5C" />
                            <TextBox Width="60"
                                     Padding="4,2"
                                     VerticalAlignment="Center"
                                     Text="{Binding Template.SelectedPlacement.FontSize, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Выравнивание:"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0"
                                       Foreground="#605E5C" />
                            <ComboBox Width="140"
                                      Padding="4,2"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Source={x:Static local:MainWindow.AlignmentOptions}}"
                                      SelectedValue="{Binding Template.SelectedPlacement.Alignment, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label" />

                            <TextBlock Text="Шрифт:"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0"
                                       Foreground="#605E5C" />
                            <ComboBox Width="160"
                                      Padding="4,2"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Source={x:Static local:MainWindow.AvailableFonts}}"
                                      SelectedItem="{Binding Template.SelectedPlacement.FontFamily, Mode=TwoWay}" />

                            <Button Content="Удалить размещение"
                                    Click="OnRemovePlacementClick"
                                    Margin="16,0,0,0"
                                    Padding="10,6"
                                    VerticalAlignment="Center"
                                    Background="#F3F3F3"
                                    BorderThickness="0"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>    
        </TabControl>
    </Grid>
</Window>