<Window x:Class="CertificateGenerator.Wpf.Views.FieldEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поле"
        Height="360"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Имя: подпись -->
            <RowDefinition Height="Auto" />  <!-- Имя: TextBox -->
            <RowDefinition Height="Auto" />  <!-- Тип: подпись -->
            <RowDefinition Height="Auto" />  <!-- Тип: ComboBox -->
            <RowDefinition Height="Auto" />  <!-- Значение: подпись (условно) -->
            <RowDefinition Height="Auto" />  <!-- Значение: TextBox (условно) -->
            <RowDefinition Height="*" />     <!-- Плашка ошибки -->
            <RowDefinition Height="Auto" />  <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Имя поля -->
        <TextBlock Grid.Row="0"
                   Text="Имя поля"
                   FontSize="13"
                   Foreground="#605E5C"
                   Margin="0,0,0,4" />

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 Padding="8,6"
                 FontSize="14"
                 TextChanged="OnNameChanged"
                 Margin="0,0,0,12" />

        <!-- Тип поля -->
        <TextBlock Grid.Row="2"
                   Text="Тип поля"
                   FontSize="13"
                   Foreground="#605E5C"
                   Margin="0,0,0,4" />

        <ComboBox x:Name="KindBox"
                  Grid.Row="3"
                  Padding="8,6"
                  FontSize="14"
                  SelectedIndex="0"
                  SelectionChanged="OnKindChanged"
                  Margin="0,0,0,12">
            <ComboBoxItem Content="Обычное" Tag="Simple" />
            <ComboBoxItem Content="ФИО (склейка из колонок)" Tag="FullName" />
            <ComboBoxItem Content="Статическое" Tag="Static" />
        </ComboBox>

        <!-- Значение для статического поля -->
        <TextBlock x:Name="StaticValueLabel"
                   Grid.Row="4"
                   Text="Значение"
                   FontSize="13"
                   Foreground="#605E5C"
                   Margin="0,0,0,4"
                   Visibility="Collapsed" />

        <TextBox x:Name="StaticValueBox"
                 Grid.Row="5"
                 Padding="8,6"
                 FontSize="14"
                 TextChanged="OnStaticValueChanged"
                 Margin="0,0,0,12"
                 Visibility="Collapsed" />

        <!-- Плашка ошибки -->
        <Border Grid.Row="6"
                x:Name="ErrorPanel"
                Background="#FDE7E9"
                BorderBrush="#C42B1C"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                Visibility="Collapsed">

            <TextBlock x:Name="ErrorText"
                       Foreground="#C42B1C"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Отмена"
                    Click="OnCancelClick"
                    Padding="16,8"
                    Background="#F3F3F3"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsCancel="True" />

            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Click="OnSaveClick"
                    Padding="16,8"
                    Margin="8,0,0,0"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>